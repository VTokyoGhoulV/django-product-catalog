# Настройки для локальной разработки. Замените пример ключа своим значением.
SECRET_KEY=replace_with_generated_secret_key
DEBUG=True

# Отдельная база PostgreSQL для проекта.
NAME=catalog_demo
USER=postgres
PASSWORD=your_postgres_password
HOST=127.0.0.1
PORT=5432

# SMTP с TLS. Заполните данными своего почтового сервиса.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_RECIPIENT=recipient@example.com
